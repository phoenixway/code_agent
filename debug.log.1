2026-02-15 15:28:37,674 - debug - DEBUG - Action.start type=create_file command={'path': 'go_examples/basic_types.go', 'content': '// basic_types.go\n// Детальні приклади основних типів у Go з коментарями українською\n\npackage main\n\nimport (\n    "fmt"\n    "reflect"\n)\n\nfunc main() {\n    // 1. ОСНОВНІ ТИПИ (PRIMITIVE TYPES)\n    // ==================================\n    fmt.Println("=== ОСНОВНІ ТИПИ ===")\n    \n    // Цілі числа (integers)\n    var age int = 30                    // int - платформозалежний (32 або 64 біти)\n    var smallNumber int8 = 127          // int8: від -128 до 127\n    var bigNumber int64 = 9223372036854775807 // int64: великі числа\n    var unsigned uint = 42              // uint - беззнакове ціле\n    \n    fmt.Printf("age (int): %d, тип: %T\\n", age, age)\n    fmt.Printf("smallNumber (int8): %d, тип: %T\\n", smallNumber, smallNumber)\n    fmt.Printf("bigNumber (int64): %d, тип: %T\\n", bigNumber, bigNumber)\n    fmt.Printf("unsigned (uint): %d, тип: %T\\n", unsigned, unsigned)\n    \n    // Числа з плаваючою точкою (floating point)\n    var price float32 = 19.99           // float32: одинарна точність\n    var precisePrice float64 = 19.9999999999 // float64: подвійна точність\n    \n    fmt.Printf("price (float32): %.2f, тип: %T\\n", price, price)\n    fmt.Printf("precisePrice (float64): %.10f, тип: %T\\n", precisePrice, precisePrice)\n    \n    // Комплексні числа (complex numbers)\n    var complexNum complex64 = 3 + 4i   // complex64: float32 для дійсної та уявної частин\n    var complexBig complex128 = 3.5 + 4.9i // complex128: float64\n    \n    fmt.Printf("complexNum (complex64): %v, тип: %T\\n", complexNum, complexNum)\n    fmt.Printf("complexBig (complex128): %v, тип: %T\\n", complexBig, complexBig)\n    \n    // Логічний тип (boolean)\n    var isReady bool = true\n    var isFinished bool = false\n    \n    fmt.Printf("isReady (bool): %v, тип: %T\\n", isReady, isReady)\n    fmt.Printf("isFinished (bool): %v, тип: %T\\n", isFinished, isFinished)\n    \n    // Рядки (strings)\n    var name string = "Іван"           // string: рядок UTF-8\n    var greeting string = `Привіт, \nсвіт!`                                // raw string literal (зворотні апострофи)\n    \n    fmt.Printf("name (string): %s, тип: %T\\n", name, name)\n    fmt.Printf("greeting (raw string): %s, тип: %T\\n", greeting, greeting)\n    \n    // 2. ПОХІДНІ ТИПИ (DERIVED TYPES)\n    // ================================\n    fmt.Println("\\n=== ПОХІДНІ ТИПИ ===")\n    \n    // Масиви (arrays) - фіксованого розміру\n    var numbers [3]int = [3]int{1, 2, 3} // масив з 3 цілих чисел\n    var days [7]string                    // оголошення масиву без ініціалізації\n    days[0] = "Понеділок"\n    \n    fmt.Printf("numbers (array): %v, тип: %T\\n", numbers, numbers)\n    fmt.Printf("days (array): %v, тип: %T\\n", days, days)\n    \n    // Зрізи (slices) - динамічні масиви\n    var sliceNumbers []int = []int{10, 20, 30, 40, 50}\n    var emptySlice []string              // nil slice\n    \n    fmt.Printf("sliceNumbers (slice): %v, тип: %T\\n", sliceNumbers, sliceNumbers)\n    fmt.Printf("emptySlice (slice): %v, тип: %T\\n", emptySlice, emptySlice)\n    \n    // Мапи (maps) - асоціативні масиви/словники\n    var person map[string]interface{} = map[string]interface{}{\n        "name": "Марія",\n        "age":  25,\n        "city": "Київ",\n    }\n    \n    fmt.Printf("person (map): %v, тип: %T\\n", person, person)\n    \n    // Структури (structs) - користувацькі типи\n    type Address struct {\n        Street  string\n        City    string\n        ZipCode string\n    }\n    \n    type Employee struct {\n        ID        int\n        FirstName string\n        LastName  string\n        Address   Address // вкладена структура\n        Active    bool\n    }\n    \n    // Ініціалізація структури\n    emp := Employee{\n        ID:        1,\n        FirstName: "Олександр",\n        LastName:  "Петренко",\n        Address: Address{\n            Street:  "Вулиця Шевченка, 15",\n            City:    "Львів",\n            ZipCode: "79000",\n        },\n        Active: true,\n    }\n    \n    fmt.Printf("emp (struct): %+v, тип: %T\\n", emp, emp)\n    \n    // 3. СПЕЦІАЛЬНІ ТИПИ\n    // ==================\n    fmt.Println("\\n=== СПЕЦІАЛЬНІ ТИПИ ===")\n    \n    // Вказівники (pointers)\n    var x int = 100\n    var ptr *int = &x // ptr тепер вказує на x\n    \n    fmt.Printf("x: %d, адреса x: %p\\n", x, &x)\n    fmt.Printf("ptr: %p, значення за ptr: %d\\n", ptr, *ptr)\n    \n    // Канали (channels) - для горутин\n    var ch chan int = make(chan int) // небуферизований канал\n    fmt.Printf("ch (channel): %v, тип: %T\\n", ch, ch)\n    \n    // Функції як типи (first-class functions)\n    var addFunc func(int, int) int = func(a, b int) int {\n        return a + b\n    }\n    \n    fmt.Printf("addFunc: %v, результат addFunc(5, 3): %d, тип: %T\\n", \n        addFunc, addFunc(5, 3), addFunc)\n    \n    // 4. REFLECTION - ДИНАМІЧНА ІНФОРМАЦІЯ ПРО ТИПИ\n    // =============================================\n    fmt.Println("\\n=== REFLECTION ===")\n    \n    // Отримання інформації про типи через reflect\n    typesToCheck := []interface{}{age, price, name, isReady, numbers, sliceNumbers, person, emp, ptr, ch}\n    \n    for i, v := range typesToCheck {\n        t := reflect.TypeOf(v)\n        kind := t.Kind()\n        fmt.Printf("%d. Значення: %v, Тип: %T, Kind: %v\\n", i+1, v, v, kind)\n    }\n}\n', 'type': 'create_file'}
