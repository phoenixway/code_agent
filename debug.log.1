2026-02-15 15:08:55,246 - debug - DEBUG - Action.start type=create_file command={'path': 'go_examples/structs_methods.go', 'content': 'package main\n\nimport (\n\t"fmt"\n)\n\n// ============================================\n// ПРИКЛАДИ СТРУКТУР ТА МЕТОДІВ У GO\n// ============================================\n\n// Структура - це користувацький тип даних, який групує поля різних типів.\n// Вона схожа на класи в інших мовах, але без успадкування.\ntype Person struct {\n\tName    string\n\tAge     int\n\tAddress string\n}\n\n// ============================================\n// МЕТОДИ З VALUE RECEIVER (приймач за значенням)\n// ============================================\n\n// Метод з value receiver отримує КОПІЮ структури.\n// Зміни всередині методу НЕ впливають на оригінальну структуру.\n// Використовується, коли метод тільки читає дані або не змінює стан.\nfunc (p Person) Greet() string {\n\treturn fmt.Sprintf("Привіт, мене звати %s, мені %d років. Я живу в %s", p.Name, p.Age, p.Address)\n}\n\n// Інший метод з value receiver - тільки для читання\nfunc (p Person) IsAdult() bool {\n\treturn p.Age >= 18\n}\n\n// ============================================\n// МЕТОДИ З POINTER RECEIVER (приймач за вказівником)\n// ============================================\n\n// Метод з pointer receiver отримує ПОСИЛАННЯ на структуру.\n// Зміни всередині методу впливають на оригінальну структуру.\n// Використовується, коли метод змінює стан структури.\nfunc (p *Person) HaveBirthday() {\n\tp.Age++ // Збільшуємо вік - зміна оригіналу\n\tfmt.Printf("%s відсвяткував(ла) день народження! Тепер йому/їй %d років.\\n", p.Name, p.Age)\n}\n\n// Ще один метод з pointer receiver для зміни стану\nfunc (p *Person) Move(newAddress string) {\n\toldAddress := p.Address\n\tp.Address = newAddress\n\tfmt.Printf("%s переїхав(ла) з %s до %s\\n", p.Name, oldAddress, newAddress)\n}\n\n// ============================================\n// КОНСТРУКТОРИ (фабричні функції)\n// ============================================\n\n// У Go немає спеціальних конструкторів, але прийнято створювати фабричні функції\n// з префіксом "New" для ініціалізації структур.\nfunc NewPerson(name string, age int, address string) *Person {\n\t// Повертаємо вказівник на нову структуру\n\treturn &Person{\n\t\tName:    name,\n\t\tAge:     age,\n\t\tAddress: address,\n\t}\n}\n\n// ============================================\n// ВКЛАДЕНІ СТРУКТУРИ (композиція)\n// ============================================\n\n// Go використовує композицію замість успадкування.\n// Структура може містити інші структури як поля.\ntype Employee struct {\n\tPerson          // Вкладена структура - поля Person стають частиною Employee\n\tEmployeeID string\n\tSalary     float64\n\tPosition   string\n}\n\n// Метод для Employee\nfunc (e *Employee) Work() {\n\tfmt.Printf("%s працює на посаді %s та отримує %.2f гривень\\n", e.Name, e.Position, e.Salary)\n}\n\n// ============================================\n// ДЕМОНСТРАЦІЯ РОБОТИ СО СТРУКТУРАМИ ТА МЕТОДАМИ\n// ============================================\n\nfunc main() {\n\tfmt.Println("=== ДЕМОНСТРАЦІЯ СТРУКТУР ТА МЕТОДІВ ===")\n\tfmt.Println()\n\n\t// Створення структури за допомогою літерала\n\tperson1 := Person{\n\t\tName:    "Іван Петренко",\n\t\tAge:     25,\n\t\tAddress: "Київ, вул. Хрещатик, 1",\n\t}\n\n\tfmt.Println("1. Створення структури Person:")\n\tfmt.Printf("   %+v\\n", person1)\n\tfmt.Println()\n\n\t// Виклик методу з value receiver\n\tfmt.Println("2. Виклик методу Greet() (value receiver):")\n\tfmt.Println("   " + person1.Greet())\n\tfmt.Println()\n\n\t// Виклик методу з pointer receiver\n\tfmt.Println("3. Виклик методу HaveBirthday() (pointer receiver):")\n\tperson1.HaveBirthday() // Go автоматично перетворює value на pointer для виклику методу\n\tfmt.Printf("   Після дня народження: %+v\\n", person1)\n\tfmt.Println()\n\n\t// Створення через конструктор\n\tperson2 := NewPerson("Марія Іваненко", 30, "Львів, вул. Свободи, 15")\n\tfmt.Println("4. Створення через конструктор NewPerson():")\n\tfmt.Printf("   %+v\\n", person2)\n\tfmt.Println("   Чи є повнолітньою?", person2.IsAdult())\n\tfmt.Println()\n\n\t// Демонстрація вкладених структур\n\temployee := Employee{\n\t\tPerson: Person{\n\t\t\tName:    "Олександр Сидоренко",\n\t\t\tAge:     35,\n\t\t\tAddress: "Одеса, вул. Дерибасівська, 10",\n\t\t},\n\t\tEmployeeID: "EMP-001",\n\t\tSalary:     25000.50,\n\t\tPosition:   "Senior Developer",\n\t}\n\n\tfmt.Println("5. Вкладена структура Employee:")\n\tfmt.Printf("   %+v\\n", employee)\n\tfmt.Println()\n\n\t// Виклик методів для Employee\n\tfmt.Println("6. Виклик методів для Employee:")\n\temployee.Work()\n\tfmt.Println("   " + employee.Greet()) // Можна викликати методи вкладеної структури\n\tfmt.Println()\n\n\t// Демонстрація різниці між value та pointer receivers\n\tfmt.Println("7. Демонстрація різниці між value та pointer receivers:")\n\t\n\t// Value receiver не змінює оригінал\n\toriginalAge := person1.Age\n\tperson1.Greet() // Тільки читання\n\tfmt.Printf("   Після виклику Greet() (value receiver): вік залишився %d\\n", person1.Age)\n\t\n\t// Pointer receiver змінює оригінал\n\tperson1.HaveBirthday()\n\tfmt.Printf("   Після виклику HaveBirthday() (pointer receiver): вік змінився з %d на %d\\n", originalAge, person1.Age)\n\tfmt.Println()\n\n\tfmt.Println("=== ДЕМОНСТРАЦІЯ ЗАВЕРШЕНА ===")\n}\n', 'before_execution': 'Створюю файл structs_methods.go з прикладами структур та методів', 'during_execution': 'Записую файл...', 'after_execution': 'Файл structs_methods.go створено з детальними коментарями', 'type': 'create_file'}
