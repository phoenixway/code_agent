2026-02-15 15:06:56,008 - debug - DEBUG - Action.start type=create_file command={'path': 'go_examples/basic_types.go', 'content': 'package main\n\nimport (\n\t"fmt"\n\t"reflect"\n)\n\nfunc main() {\n\t// ============================================\n\t// ОСНОВНІ ТИПИ В GO\n\t// ============================================\n\t\n\t// 1. ЦІЛІ ЧИСЛА (INTEGERS)\n\t// Go має кілька типів цілих чисел різного розміру та знаковості\n\tvar int8Example int8 = 127        // 8-бітне знакове число (-128 до 127)\n\tvar uint8Example uint8 = 255      // 8-бітне беззнакове число (0 до 255)\n\tvar int16Example int16 = 32767    // 16-бітне знакове\n\tvar uint16Example uint16 = 65535  // 16-бітне беззнакове\n\tvar int32Example int32 = 2147483647 // 32-бітне знакове\n\tvar uint32Example uint32 = 4294967295 // 32-бітне беззнакове\n\tvar int64Example int64 = 9223372036854775807 // 64-бітне знакове\n\tvar uint64Example uint64 = 18446744073709551615 // 64-бітне беззнакове\n\t\n\t// int та uint - залежать від архітектури (32 або 64 біти на сучасних системах)\n\tvar intExample int = -500\n\tvar uintExample uint = 500\n\t\n\t// byte - синонім для uint8, використовується для роботи з байтами\n\tvar byteExample byte = 65 // ASCII код для \'A\'\n\t\n\t// rune - синонім для int32, представляє Unicode кодпоінт\n\tvar runeExample rune = \'Я\' // Unicode символ\n\t\n\tfmt.Println("=== ЦІЛІ ЧИСЛА ===")\n\tfmt.Printf("int8: %d, тип: %s\\n", int8Example, reflect.TypeOf(int8Example))\n\tfmt.Printf("uint8: %d, тип: %s\\n", uint8Example, reflect.TypeOf(uint8Example))\n\tfmt.Printf("byte: %d (символ: %c), тип: %s\\n", byteExample, byteExample, reflect.TypeOf(byteExample))\n\tfmt.Printf("rune: %d (символ: %c), тип: %s\\n", runeExample, runeExample, reflect.TypeOf(runeExample))\n\t\n\t// 2. ЧИСЛА З ПЛАВАЮЧОЮ КОМОЮ (FLOATING-POINT)\n\tvar float32Example float32 = 3.141592653589793 // Точність ~6-7 десяткових цифр\n\tvar float64Example float64 = 3.141592653589793 // Точність ~15 десяткових цифр (рекомендовано)\n\t\n\tfmt.Println("\\n=== ЧИСЛА З ПЛАВАЮЧОЮ КОМОЮ ===")\n\tfmt.Printf("float32: %.10f, тип: %s\\n", float32Example, reflect.TypeOf(float32Example))\n\tfmt.Printf("float64: %.15f, тип: %s\\n", float64Example, reflect.TypeOf(float64Example))\n\t\n\t// 3. КОМПЛЕКСНІ ЧИСЛА (COMPLEX)\n\tvar complex64Example complex64 = 3 + 4i\n\tvar complex128Example complex128 = complex(5, 12) // 5 + 12i\n\t\n\tfmt.Println("\\n=== КОМПЛЕКСНІ ЧИСЛА ===")\n\tfmt.Printf("complex64: %v, тип: %s\\n", complex64Example, reflect.TypeOf(complex64Example))\n\tfmt.Printf("complex128: %v, тип: %s\\n", complex128Example, reflect.TypeOf(complex128Example))\n\t\n\t// 4. БУЛЕВИЙ ТИП (BOOLEAN)\n\tvar boolTrue bool = true\n\tvar boolFalse bool = false\n\tvar boolFromExpression bool = (10 > 5)\n\t\n\tfmt.Println("\\n=== БУЛЕВИЙ ТИП ===")\n\tfmt.Printf("boolTrue: %v, тип: %s\\n", boolTrue, reflect.TypeOf(boolTrue))\n\tfmt.Printf("boolFalse: %v, тип: %s\\n", boolFalse, reflect.TypeOf(boolFalse))\n\tfmt.Printf("10 > 5: %v, тип: %s\\n", boolFromExpression, reflect.TypeOf(boolFromExpression))\n\t\n\t// 5. РЯДКИ (STRINGS)\n\t// Рядки в Go - це незмінні послідовності байтів\n\tvar stringExample string = "Привіт, світ!"\n\tvar rawString string = `Це "сирий" рядок\n\tвін може містити багато рядків\n\tі не екранує спецсимволи`\n\t\n\t// Довжина рядка в байтах (не в символах!)\n\tstringLength := len(stringExample)\n\t\n\t// Отримання символу (байта) за індексом\n\tfirstByte := stringExample[0]\n\t\n\t// Конкатенація рядків\n\tconcatenated := stringExample + " Додатковий текст"\n\t\n\tfmt.Println("\\n=== РЯДКИ ===")\n\tfmt.Printf("stringExample: %s, тип: %s\\n", stringExample, reflect.TypeOf(stringExample))\n\tfmt.Printf("Довжина в байтах: %d\\n", stringLength)\n\tfmt.Printf("Перший байт: %d (символ: %c)\\n", firstByte, firstByte)\n\tfmt.Printf("Конкатенація: %s\\n", concatenated)\n\tfmt.Println("Сирий рядок:", rawString)\n\t\n\t// 6. НУЛЬОВІ ЗНАЧЕННЯ (ZERO VALUES)\n\t// Кожен тип має нульове значення, яке присвоюється за замовчуванням\n\tvar zeroInt int          // 0\n\tvar zeroFloat float64    // 0.0\n\tvar zeroBool bool        // false\n\tvar zeroString string    // "" (порожній рядок)\n\tvar zeroPointer *int     // nil\n\t\n\tfmt.Println("\\n=== НУЛЬОВІ ЗНАЧЕННЯ ===")\n\tfmt.Printf("zeroInt: %d\\n", zeroInt)\n\tfmt.Printf("zeroFloat: %f\\n", zeroFloat)\n\tfmt.Printf("zeroBool: %v\\n", zeroBool)\n\tfmt.Printf("zeroString: \'%s\'\\n", zeroString)\n\tfmt.Printf("zeroPointer: %v\\n", zeroPointer)\n\t\n\t// 7. ТИПІЗАЦІЯ ТА ПЕРЕТВОРЕННЯ ТИПІВ (TYPE CONVERSION)\n\t// Go має строгу типізацію, перетворення має бути явним\n\tvar x int32 = 100\n\tvar y int64 = int64(x) // Явне перетворення int32 -> int64\n\t\n\t// Перетворення між числовими типами\n\tvar floatFromInt float64 = float64(x)\n\tvar intFromFloat int32 = int32(3.99) // Дробова частина відкидається (3)\n\t\n\t// Перетворення рядка в зріз байтів та навпаки\n\tstr := "Go"\n\tbytes := []byte(str) // [71 111]\n\tstrFromBytes := string(bytes) // "Go"\n\t\n\tfmt.Println("\\n=== ПЕРЕТВОРЕННЯ ТИПІВ ===")\n\tfmt.Printf("int32 -> int64: %d -> %d\\n", x, y)\n\tfmt.Printf("int32 -> float64: %d -> %.2f\\n", x, floatFromInt)\n\tfmt.Printf("float -> int32: 3.99 -> %d (втрата дробової частини)\\n", intFromFloat)\n\tfmt.Printf("Рядок -> байти: \\"%s\\" -> %v\\n", str, bytes)\n\tfmt.Printf("Байти -> рядок: %v -> \\"%s\\"\\n", bytes, strFromBytes)\n}\n', 'type': 'create_file'}
