2026-02-15 14:41:51,207 - debug - DEBUG - Action.start type=create_file command={'before_execution': 'Створю перший файл: basic_types_pointers.go з основами типів та вказівників', 'during_execution': 'Записую файл з детальними коментарами...', 'after_execution': 'Файл basic_types_pointers.go створено', 'path': 'go_tutorial/basic_types_pointers.go', 'content': '// basic_types_pointers.go\n// Детальний туторіал по основам типів та вказівників у Go\n// Автор: Angelica AI\n\npackage main\n\nimport (\n\t"fmt"\n)\n\nfunc main() {\n\tfmt.Println("=== ОСНОВИ ТИПІВ ТА ВКАЗІВНИКІВ У GO ===")\n\t\n\t// ============================================\n\t// 1. ОСНОВНІ ТИПИ ДАНИХ У GO\n\t// ============================================\n\t\n\t// Цілі числа\n\tvar integer int = 42          // int - ціле число зі знаком (розмір залежить від архітектури)\n\tvar unsigned uint = 100       // uint - ціле число без знаку\n\tvar int8Val int8 = 127        // int8 - 8-бітне ціле число (-128 до 127)\n\tvar int64Val int64 = 1<<63 - 1 // int64 - 64-бітне ціле число\n\t\n\t// Числа з плаваючою точкою\n\tvar floatVal float32 = 3.14   // float32 - 32-бітне число з плаваючою точкою\n\tvar doubleVal float64 = 2.71828 // float64 - 64-бітне число з плаваючою точкою (аналог double)\n\t\n\t// Булеві значення\n\tvar isTrue bool = true        // bool - логічне значення (true/false)\n\tvar isFalse bool = false\n\t\n\t// Рядки\n\tvar greeting string = "Привіт, Go!" // string - рядок (незмінний масив байтів)\n\t\n\t// Символи (руни)\n\tvar char rune = \'A\'            // rune - псевдонім для int32, представляє Unicode кодпоінт\n\t\n\t// Комплексні числа\n\tvar complexVal complex64 = 1 + 2i // complex64 - комплексне число з float32 частинами\n\t\n\tfmt.Printf("Ціле число: %d\\n", integer)\n\tfmt.Printf("Рядок: %s\\n", greeting)\n\tfmt.Printf("Булеве значення: %t\\n", isTrue)\n\t\n\t// ============================================\n\t// 2. ВКАЗІВНИКИ (POINTERS) - ОСНОВИ\n\t// ============================================\n\t\n\t/*\n\tВказівник у Go - це змінна, яка зберігає адресу пам\'яті іншої змінної.\n\tСинтаксис:\n\t  var ptr *int        // Оголошення вказівника на int\n\t  ptr = &variable     // Отримання адреси змінної (оператор &)\n\t  *ptr = 100          // Розіменування вказівника (оператор *)\n\t*/\n\t\n\tvar x int = 10\n\tfmt.Printf("\\n=== Вказівники ===\\n")\n\tfmt.Printf("Початкове значення x: %d\\n", x)\n\tfmt.Printf("Адреса змінної x: %p\\n", &x)\n\t\n\t// Створення вказівника на x\n\tvar ptr *int = &x\n\tfmt.Printf("Вказівник ptr містить адресу: %p\\n", ptr)\n\tfmt.Printf("Значення за адресою ptr: %d\\n", *ptr)\n\t\n\t// Зміна значення через вказівник\n\t*ptr = 20\n\tfmt.Printf("Нове значення x після зміни через ptr: %d\\n", x)\n\t\n\t// ============================================\n\t// 3. НУЛЬОВІ ВКАЗІВНИКИ ТА nil\n\t// ============================================\n\t\n\t/*\n\tНульове значення для вказівників - nil.\n\tСпроба розіменувати nil вказівник призведе до panic.\n\t*/\n\t\n\tvar nilPtr *int\n\tfmt.Printf("\\n=== Нульові вказівники ===\\n")\n\tfmt.Printf("nilPtr дорівнює nil: %t\\n", nilPtr == nil)\n\t\n\t// Безпечна перевірка перед розіменуванням\n\tif nilPtr != nil {\n\t\tfmt.Printf("Значення nilPtr: %d\\n", *nilPtr)\n\t} else {\n\t\tfmt.Println("nilPtr є nil, не можна розіменувати")\n\t}\n\t\n\t// ============================================\n\t// 4. ВКАЗІВНИКИ НА РІЗНІ ТИПИ\n\t// ============================================\n\t\n\tvar str string = "Hello"\n\tvar strPtr *string = &str\n\t\n\tvar flag bool = true\n\tvar flagPtr *bool = &flag\n\t\n\tfmt.Printf("\\n=== Вказівники на різні типи ===\\n")\n\tfmt.Printf("Рядок через вказівник: %s\\n", *strPtr)\n\tfmt.Printf("Булеве значення через вказівник: %t\\n", *flagPtr)\n\t\n\t// ============================================\n\t// 5. ФУНКЦІЇ ТА ВКАЗІВНИКИ\n\t// ============================================\n\t\n\t/*\n\tВказівники часто використовуються у функціях для:\n\t1. Зміни значень змінних за межами функції\n\t2. Уникнення копіювання великих структур\n\t3. Повернення кількох значень через параметри\n\t*/\n\t\n\tvalue := 5\n\tfmt.Printf("\\n=== Функції та вказівники ===\\n")\n\tfmt.Printf("До виклику doubleValue: %d\\n", value)\n\tdoubleValue(&value) // Передаємо адресу змінної\n\tfmt.Printf("Після виклику doubleValue: %d\\n", value)\n\t\n\t// ============================================\n\t// 6. NEW() ФУНКЦІЯ ДЛЯ СТВОРЕННЯ ВКАЗІВНИКІВ\n\t// ============================================\n\t\n\t/*\n\tФункція new(T) створює змінну типу T, ініціалізує її нульовим значенням,\n\tі повертає вказівник на неї (*T).\n\t*/\n\t\n\tptrViaNew := new(int) // Створює вказівник на int з нульовим значенням\n\tfmt.Printf("\\n=== Функція new() ===\\n")\n\tfmt.Printf("Значення через new: %d\\n", *ptrViaNew)\n\t*ptrViaNew = 99\n\tfmt.Printf("Нове значення: %d\\n", *ptrViaNew)\n\t\n\t// ============================================\n\t// 7. ПОРІВНЯННЯ ВКАЗІВНИКІВ\n\t// ============================================\n\t\n\ta := 10\n\tb := 10\n\tptr1 := &a\n\tptr2 := &a // Вказують на ту саму змінну\n\tptr3 := &b // Вказують на іншу змінну з таким самим значенням\n\t\n\tfmt.Printf("\\n=== Порівняння вказівників ===\\n")\n\tfmt.Printf("ptr1 == ptr2 (одна адреса): %t\\n", ptr1 == ptr2)\n\tfmt.Printf("ptr1 == ptr3 (різні адреси): %t\\n", ptr1 == ptr3)\n\tfmt.Printf("*ptr1 == *ptr3 (однакові значення): %t\\n", *ptr1 == *ptr3)\n}\n\n// doubleValue подвоює значення за вказівником\nfunc doubleValue(ptr *int) {\n\t/*\n\tЦя функція отримує вказівник на int.\n\tВона може змінити оригінальне значення,\n\tна яке вказує ptr.\n\t*/\n\tif ptr != nil { // Завжди перевіряйте на nil!\n\t\t*ptr = *ptr * 2\n\t\tfmt.Printf("  (внутрі функції) Подвоєне значення: %d\\n", *ptr)\n\t}\n}\n\n/*\nКЛЮЧОВІ ВИСНОВКИ:\n1. Вказівники дозволяють працювати з адресами пам\'яті замість значень\n2. Оператор & отримує адресу змінної\n3. Оператор * розіменовує вказівник (отримує значення за адресою)\n4. Нульове значення вказівника - nil\n5. Вказівники дозволяють змінювати змінні у функціях\n6. Функція new(T) створює вказівник на нульове значення типу T\n7. Два вказівники рівні, якщо вони вказують на ту саму адресу пам\'яті\n*/', 'type': 'create_file'}
