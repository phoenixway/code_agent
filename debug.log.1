2026-02-15 15:10:44,316 - debug - DEBUG - Action.start type=create_file command={'path': 'go_examples/interfaces.go', 'before_execution': 'Створюю файл interfaces.go з прикладами інтерфейсів та їх реалізації', 'during_execution': 'Записую файл...', 'after_execution': 'Файл interfaces.go створено з детальними коментарями', 'content': 'package main\n\nimport (\n\t"fmt"\n\t"math"\n)\n\n// ============================================\n// ІНТЕРФЕЙСИ В GO\n// ============================================\n// Інтерфейс - це набір методів, які тип повинен реалізувати.\n// Тип автоматично реалізує інтерфейс, якщо він має всі його методи.\n// Це називається "утиною типізацією" (duck typing).\n\n// ============================================\n// БАЗОВИЙ ПРИКЛАД ІНТЕРФЕЙСУ\n// ============================================\n\n// Shape - інтерфейс для геометричних фігур\ntype Shape interface {\n\tArea() float64\n\tPerimeter() float64\n}\n\n// Circle - структура, що реалізує інтерфейс Shape\ntype Circle struct {\n\tRadius float64\n}\n\n// Area - метод для обчислення площі кола\nfunc (c Circle) Area() float64 {\n\treturn math.Pi * c.Radius * c.Radius\n}\n\n// Perimeter - метод для обчислення периметра кола\nfunc (c Circle) Perimeter() float64 {\n\treturn 2 * math.Pi * c.Radius\n}\n\n// Rectangle - структура, що реалізує інтерфейс Shape\ntype Rectangle struct {\n\tWidth, Height float64\n}\n\n// Area - метод для обчислення площі прямокутника\nfunc (r Rectangle) Area() float64 {\n\treturn r.Width * r.Height\n}\n\n// Perimeter - метод для обчислення периметра прямокутника\nfunc (r Rectangle) Perimeter() float64 {\n\treturn 2 * (r.Width + r.Height)\n}\n\n// ============================================\n// ПУСТИЙ ІНТЕРФЕЙС (interface{})\n// ============================================\n// Пустий інтерфейс не має методів, тому його реалізує будь-який тип.\n// Використовується для створення універсальних функцій.\n\n// PrintAny - функція, що приймає будь-який тип через пустий інтерфейс\nfunc PrintAny(value interface{}) {\n\tfmt.Printf("Тип: %T, Значення: %v\\n", value, value)\n}\n\n// ============================================\n// ТИПОВЕ ТВЕРДЖЕННЯ (Type Assertion)\n// ============================================\n// Дозволяє отримати конкретний тип зі значення інтерфейсу.\n\nfunc processShape(s Shape) {\n\t// Спробуємо отримати конкретний тип\n\tif circle, ok := s.(Circle); ok {\n\t\tfmt.Printf("Це коло з радіусом: %.2f\\n", circle.Radius)\n\t} else if rect, ok := s.(Rectangle); ok {\n\t\tfmt.Printf("Це прямокутник: %.2f x %.2f\\n", rect.Width, rect.Height)\n\t} else {\n\t\tfmt.Println("Невідома фігура")\n\t}\n}\n\n// ============================================\n// ПЕРЕКЛЮЧЕННЯ ТИПІВ (Type Switch)\n// ============================================\n// Спеціальна конструкція для роботи з типами в інтерфейсах.\n\nfunc describeType(i interface{}) {\n\tswitch v := i.(type) {\n\tcase int:\n\t\tfmt.Printf("Це ціле число: %d\\n", v)\n\tcase string:\n\t\tfmt.Printf("Це рядок: %s\\n", v)\n\tcase Circle:\n\t\tfmt.Printf("Це коло з площею: %.2f\\n", v.Area())\n\tcase Rectangle:\n\t\tfmt.Printf("Це прямокутник з периметром: %.2f\\n", v.Perimeter())\n\tdefault:\n\t\tfmt.Printf("Невідомий тип: %T\\n", v)\n\t}\n}\n\n// ============================================\n// ВКЛАДЕНІ ІНТЕРФЕЙСИ\n// ============================================\n// Інтерфейси можуть включати інші інтерфейси.\n\ntype Resizable interface {\n\tResize(factor float64)\n}\n\ntype ResizableShape interface {\n\tShape\n\tResizable\n}\n\n// Square - структура, що реалізує ResizableShape\ntype Square struct {\n\tSide float64\n}\n\nfunc (s Square) Area() float64 {\n\treturn s.Side * s.Side\n}\n\nfunc (s Square) Perimeter() float64 {\n\treturn 4 * s.Side\n}\n\nfunc (s *Square) Resize(factor float64) {\n\ts.Side *= factor\n}\n\n// ============================================\n// ГОЛОВНА ФУНКЦІЯ\n// ============================================\n\nfunc main() {\n\tfmt.Println("=== ПРИКЛАДИ ІНТЕРФЕЙСІВ ===")\n\t\n\t// Створення фігур\n\tcircle := Circle{Radius: 5}\n\trect := Rectangle{Width: 4, Height: 6}\n\t\n\t// Використання інтерфейсу\n\tvar shape Shape\n\t\n\tshape = circle\n\tfmt.Printf("Коло: площа=%.2f, периметр=%.2f\\n", shape.Area(), shape.Perimeter())\n\t\n\tshape = rect\n\tfmt.Printf("Прямокутник: площа=%.2f, периметр=%.2f\\n", shape.Area(), shape.Perimeter())\n\t\n\t// Масив фігур через інтерфейс\n\tshapes := []Shape{circle, rect}\n\tfmt.Println("\\nМасив фігур:")\n\tfor i, s := range shapes {\n\t\tfmt.Printf("  Фігура %d: площа=%.2f\\n", i+1, s.Area())\n\t}\n\t\n\t// Пустий інтерфейс\n\tfmt.Println("\\nПустий інтерфейс:")\n\tPrintAny(42)\n\tPrintAny("Hello")\n\tPrintAny(circle)\n\t\n\t// Типове твердження\n\tfmt.Println("\\nТипове твердження:")\n\tprocessShape(circle)\n\tprocessShape(rect)\n\t\n\t// Переключення типів\n\tfmt.Println("\\nПереключення типів:")\n\tdescribeType(100)\n\tdescribeType("Golang")\n\tdescribeType(circle)\n\tdescribeType(3.14)\n\t\n\t// Вкладені інтерфейси\n\tfmt.Println("\\nВкладені інтерфейси:")\n\tsquare := &Square{Side: 3}\n\tfmt.Printf("Квадрат до зміни: сторона=%.2f, площа=%.2f\\n", square.Side, square.Area())\n\t\n\tvar resizableShape ResizableShape = square\n\tresizableShape.Resize(2.0)\n\tfmt.Printf("Квадрат після зміни: сторона=%.2f, площа=%.2f\\n", square.Side, square.Area())\n\t\n\tfmt.Println("\\n=== КІНЕЦЬ ПРИКЛАДІВ ===")\n}\n', 'type': 'create_file'}
