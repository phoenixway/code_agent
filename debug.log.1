2026-02-15 15:31:02,836 - debug - DEBUG - Action.start type=create_file command={'path': 'go_examples/basic_types.go', 'content': '// basic_types.go\n// Детальні приклади основних типів у Go з коментарями українською мовою\n\npackage main\n\nimport (\n\t"fmt"\n\t"reflect"\n)\n\nfunc main() {\n\tfmt.Println("=== ПРИКЛАДИ ОСНОВНИХ ТИПІВ GO ===")\n\t\n\t// 1. БАЗОВІ ЧИСЛОВІ ТИПИ\n\t// ========================\n\tfmt.Println("\\n1. Базові числові типи:")\n\t\n\t// Цілі числа з різною розрядністю та знаковістю\n\tvar int8Example int8 = 127          // 8-бітне ціле зі знаком (-128 до 127)\n\tvar uint8Example uint8 = 255        // 8-бітне ціле без знаку (0 до 255)\n\tvar int32Example int32 = 2147483647 // 32-бітне ціле зі знаком\n\tvar uint64Example uint64 = 18446744073709551615 // 64-бітне ціле без знаку\n\t\n\tfmt.Printf("int8: %d, тип: %T\\n", int8Example, int8Example)\n\tfmt.Printf("uint8: %d, тип: %T\\n", uint8Example, uint8Example)\n\tfmt.Printf("int32: %d, тип: %T\\n", int32Example, int32Example)\n\tfmt.Printf("uint64: %d, тип: %T\\n", uint64Example, uint64Example)\n\t\n\t// Числа з плаваючою точкою\n\tvar float32Example float32 = 3.1415927 // 32-бітне число з плаваючою точкою\n\tvar float64Example float64 = 3.141592653589793 // 64-бітне (більша точність)\n\t\n\tfmt.Printf("float32: %.7f, тип: %T\\n", float32Example, float32Example)\n\tfmt.Printf("float64: %.15f, тип: %T\\n", float64Example, float64Example)\n\t\n\t// Комплексні числа\n\tvar complex64Example complex64 = 3 + 4i\n\tvar complex128Example complex128 = complex(5, 12)\n\t\n\tfmt.Printf("complex64: %v, тип: %T\\n", complex64Example, complex64Example)\n\tfmt.Printf("complex128: %v, тип: %T\\n", complex128Example, complex128Example)\n\t\n\t// 2. БУЛЕВИЙ ТИП\n\t// ==============\n\tfmt.Println("\\n2. Булевий тип:")\n\t\n\tvar isTrue bool = true\n\tvar isFalse bool = false\n\tvar logicalResult bool = isTrue && !isFalse // Логічна операція\n\t\n\tfmt.Printf("isTrue: %v, тип: %T\\n", isTrue, isTrue)\n\tfmt.Printf("isFalse: %v, тип: %T\\n", isFalse, isFalse)\n\tfmt.Printf("logicalResult (isTrue && !isFalse): %v\\n", logicalResult)\n\t\n\t// 3. РЯДКОВИЙ ТИП (STRING)\n\t// ========================\n\tfmt.Println("\\n3. Рядковий тип:")\n\t\n\tvar singleLine string = "Це звичайний рядок"\n\tvar multiLine string = `Це багаторядковий\nрядковий літерал з використанням\nзворотних апострофів`\n\t\n\t// Рядки в Go незмінні (immutable)\n\tfmt.Printf("singleLine: %s, довжина: %d\\n", singleLine, len(singleLine))\n\tfmt.Printf("multiLine:\\n%s\\n", multiLine)\n\t\n\t// Конкатенація рядків\n\tvar concatString string = "Hello, " + "World!"\n\tfmt.Printf("Конкатенація: %s\\n", concatString)\n\t\n\t// 4. МАСИВИ (ARRAYS)\n\t// ==================\n\tfmt.Println("\\n4. Масиви (фіксованого розміру):")\n\t\n\t// Масив фіксованого розміру - розмір є частиною типу\n\tvar intArray [5]int = [5]int{1, 2, 3, 4, 5}\n\tvar stringArray [3]string = [3]string{"перший", "другий", "третій"}\n\t\n\t// Автоматичне визначення розміру\n\tautoArray := [...]int{10, 20, 30, 40}\n\t\n\tfmt.Printf("intArray: %v, тип: %T, розмір: %d\\n", intArray, intArray, len(intArray))\n\tfmt.Printf("stringArray: %v, тип: %T\\n", stringArray, stringArray)\n\tfmt.Printf("autoArray: %v, тип: %T, розмір: %d\\n", autoArray, autoArray, len(autoArray))\n\t\n\t// Доступ до елементів масиву\n\tfmt.Printf("intArray[0]: %d, intArray[4]: %d\\n", intArray[0], intArray[4])\n\t\n\t// 5. ЗРІЗИ (SLICES)\n\t// =================\n\tfmt.Println("\\n5. Зрізи (динамічні масиви):")\n\t\n\t// Створення зрізів різними способами\n\tvar slice1 []int = []int{1, 2, 3, 4, 5}\n\tslice2 := make([]string, 3) // Зріз з 3 елементів\n\tslice2[0] = "а"\n\tslice2[1] = "б"\n\tslice2[2] = "в"\n\t\n\t// Зріз з певною місткістю (capacity)\n\tslice3 := make([]float64, 2, 5) // Довжина 2, місткість 5\n\tslice3[0] = 1.5\n\tslice3[1] = 2.5\n\t\n\tfmt.Printf("slice1: %v, тип: %T, довжина: %d, місткість: %d\\n", \n\t\tslice1, slice1, len(slice1), cap(slice1))\n\tfmt.Printf("slice2: %v, тип: %T, довжина: %d\\n", slice2, slice2, len(slice2))\n\tfmt.Printf("slice3: %v, тип: %T, довжина: %d, місткість: %d\\n", \n\t\tslice3, slice3, len(slice3), cap(slice3))\n\t\n\t// Операції зі зрізами\n\tslice1 = append(slice1, 6, 7, 8) // Додавання елементів\n\tfmt.Printf("slice1 після append: %v, довжина: %d\\n", slice1, len(slice1))\n\t\n\t// Підзріз (slice expression)\n\tsubSlice := slice1[2:5] // Елементи з індексами 2, 3, 4\n\tfmt.Printf("subSlice (slice1[2:5]): %v\\n", subSlice)\n\t\n\t// 6. КАРТИ (MAPS)\n\t// ===============\n\tfmt.Println("\\n6. Карти (асоціативні масиви):")\n\t\n\t// Створення карти різними способами\n\tvar map1 map[string]int = map[string]int{\n\t\t"яблуко": 5,\n\t\t"банан": 3,\n\t\t"апельсин": 7,\n\t}\n\t\n\tmap2 := make(map[int]string)\n\tmap2[1] = "один"\n\tmap2[2] = "два"\n\tmap2[3] = "три"\n\t\n\tfmt.Printf("map1: %v, тип: %T\\n", map1, map1)\n\tfmt.Printf("map2: %v, тип: %T\\n", map2, map2)\n\t\n\t// Доступ до елементів карти\n\tvalue, exists := map1["яблуко"]\n\tfmt.Printf("map1[\\"яблуко\\"]: %d, exists: %v\\n", value, exists)\n\t\n\t// Перебір карти\n\tfmt.Println("Перебір map1:")\n\tfor key, val := range map1 {\n\t\tfmt.Printf("  %s: %d\\n", key, val)\n\t}\n\t\n\t// 7. СТРУКТУРИ (STRUCTS)\n\t// ======================\n\tfmt.Println("\\n7. Структури (користувацькі типи):")\n\t\n\t// Оголошення структури\n\ttype Person struct {\n\t\tFirstName string\n\t\tLastName  string\n\t\tAge       int\n\t\tEmail     string\n\t}\n\t\n\t// Створення екземпляра структури\n\tvar person1 Person = Person{\n\t\tFirstName: "Іван",\n\t\tLastName:  "Петренко",\n\t\tAge:       30,\n\t\tEmail:     "ivan@example.com",\n\t}\n\t\n\t// Короткий запис (порядок полів важливий)\n\tperson2 := Person{"Марія", "Іваненко", 25, "maria@example.com"}\n\t\n\t// Створення з нульовими значеннями\n\tvar person3 Person\n\tperson3.FirstName = "Петро"\n\tperson3.Age = 35\n\t\n\tfmt.Printf("person1: %+v, тип: %T\\n", person1, person1)\n\tfmt.Printf("person2: %+v\\n", person2)\n\tfmt.Printf("person3: %+v\\n", person3)\n\t\n\t// Анонімні структури\n\tanonStruct := struct {\n\t\tID   int\n\t\tName string\n\t}{\n\t\tID:   1,\n\t\tName: "Анонімний об\'єкт",\n\t}\n\tfmt.Printf("Анонімна структура: %+v\\n", anonStruct)\n\t\n\t// 8. ВКАЗІВНИКИ (POINTERS)\n\t// ========================\n\tfmt.Println("\\n8. Вказівники:")\n\t\n\tvar x int = 42\n\tvar ptr *int = &x // & - оператор взяття адреси\n\t\n\tfmt.Printf("x = %d, адреса x: %p\\n", x, &x)\n\tfmt.Printf("ptr = %p, значення за ptr (*ptr) = %d\\n", ptr, *ptr)\n\t\n\t// Зміна значення через вказівник\n\t*ptr = 100\n\tfmt.Printf("Після *ptr = 100: x = %d\\n", x)\n\t\n\t// Нульовий вказівник\n\tvar nilPtr *int\n\tfmt.Printf("nilPtr: %v, nilPtr == nil: %v\\n", nilPtr, nilPtr == nil)\n\t\n\t// 9. КАНАЛИ (CHANNELS)\n\t// ====================\n\tfmt.Println("\\n9. Канали (для горутин):")\n\t\n\t// Буферизований канал\n\tch := make(chan int, 2)\n\tch <- 10\n\tch <- 20\n\t\n\tfmt.Printf("Отримано з каналу: %d\\n", <-ch)\n\tfmt.Printf("Отримано з каналу: %d\\n", <-ch)\n\t\n\t// 10. ФУНКЦІЇ ЯК ЗНАЧЕННЯ\n\t// =======================\n\tfmt.Println("\\n10. Функції як значення:")\n\t\n\t// Оголошення типу функції\n\ttype MathFunc func(int, int) int\n\t\n\t// Присвоєння функції змінній\n\tvar addFunc MathFunc = func(a, b int) int {\n\t\treturn a + b\n\t}\n\t\n\tmultiplyFunc := func(a, b int) int {\n\t\treturn a * b\n\t}\n\t\n\tfmt.Printf("addFunc(5, 3) = %d\\n", addFunc(5, 3))\n\tfmt.Printf("multiplyFunc(5, 3) = %d\\n", multiplyFunc(5, 3))\n\t\n\t// 11. ПЕРЕВІРКА ТИПІВ ЗА ДОПОМОГОЮ reflect\n\t// ========================================\n\tfmt.Println("\\n11. Перевірка типів (reflect):")\n\t\n\tvar samples = []interface{}{\n\t\t42,\n\t\t3.14,\n\t\t"рядок",\n\t\ttrue,\n\t\t[3]int{1, 2, 3},\n\t\t[]string{"a", "b"},\n\t\tmap[string]int{"x": 1},\n\t\tPerson{FirstName: "Тест"},\n\t}\n\t\n\tfor i, sample := range samples {\n\t\ttypeName := reflect.TypeOf(sample).String()\n\t\tfmt.Printf("  [%d] %v -> тип: %s\\n", i, sample, typeName)\n\t}\n\t\n\tfmt.Println("\\n=== КІНЕЦЬ ПРИКЛАДІВ ОСНОВНИХ ТИПІВ ===")\n}\n', 'before_execution': 'Створюю перший файл з прикладами основних типів Go', 'during_execution': 'Записую файл basic_types.go...', 'after_execution': 'Файл basic_types.go створено з детальними коментарями', 'type': 'create_file'}
