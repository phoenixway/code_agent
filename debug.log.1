2026-02-15 15:11:54,361 - debug - DEBUG - Action.start type=create_file command={'path': 'go_examples/collections.go', 'before_execution': 'Створюю файл collections.go з прикладами колекцій: мап, зрізів, масивів та каналів', 'during_execution': 'Записую файл...', 'after_execution': 'Файл collections.go створено з детальними коментарями', 'content': 'package main\n\nimport (\n\t"fmt"\n)\n\n// ============================================\n// КОЛЕКЦІЇ В GO: МАСИВИ, ЗРІЗИ, МАПИ, КАНАЛИ\n// ============================================\n\nfunc main() {\n\tfmt.Println("=== ПРИКЛАДИ КОЛЕКЦІЙ В GO ===")\n\t\n\t// 1. МАСИВИ (ARRAYS)\n\t// Масив - це фіксована колекція елементів одного типу\n\t// Розмір масиву є частиною його типу, тому [3]int та [5]int - це різні типи\n\tfmt.Println("\\n1. МАСИВИ:")\n\t\n\t// Оголошення та ініціалізація масиву\n\tvar arr1 [3]int           // масив з 3 цілих чисел, ініціалізовані нулями\n\tarr2 := [3]int{1, 2, 3}   // масив з явно вказаними значеннями\n\tarr3 := [...]int{4, 5, 6} // компілятор сам визначить розмір (3)\n\t\n\tfmt.Printf("arr1: %v (тип: %T)\\n", arr1, arr1)\n\tfmt.Printf("arr2: %v (тип: %T)\\n", arr2, arr2)\n\tfmt.Printf("arr3: %v (тип: %T)\\n", arr3, arr3)\n\t\n\t// Доступ до елементів масиву\n\tarr2[0] = 10\n\tfmt.Printf("arr2 після зміни: %v\\n", arr2)\n\t\n\t// Довжина масиву\n\tfmt.Printf("Довжина arr3: %d\\n", len(arr3))\n\t\n\t// 2. ЗРІЗИ (SLICES)\n\t// Зріз - це динамічна обгортка над масивом, може змінювати розмір\n\t// Зрізи є посиланнями на базовий масив\n\tfmt.Println("\\n2. ЗРІЗИ:")\n\t\n\t// Створення зрізів різними способами\n\tvar slice1 []int                    // нульовий зріз (nil)\n\tslice2 := []int{1, 2, 3, 4, 5}      // зріз з літералом\n\tslice3 := make([]int, 3, 5)         // make(тип, довжина, місткість)\n\tslice4 := arr2[:]                    // зріз з існуючого масиву\n\t\n\tfmt.Printf("slice1: %v (nil? %v)\\n", slice1, slice1 == nil)\n\tfmt.Printf("slice2: %v (довжина: %d, місткість: %d)\\n", slice2, len(slice2), cap(slice2))\n\tfmt.Printf("slice3: %v (довжина: %d, місткість: %d)\\n", slice3, len(slice3), cap(slice3))\n\tfmt.Printf("slice4: %v (базовий масив: %v)\\n", slice4, arr2)\n\t\n\t// Операції зі зрізами\n\tslice2 = append(slice2, 6, 7)       // додавання елементів\n\tfmt.Printf("slice2 після append: %v (довжина: %d, місткість: %d)\\n", \n\t\tslice2, len(slice2), cap(slice2))\n\t\n\t// Зріз зрізу (slicing)\n\tsubSlice := slice2[1:4]              // елементи з індексами 1, 2, 3\n\tfmt.Printf("subSlice (slice2[1:4]): %v\\n", subSlice)\n\t\n\t// Важливо: зміна subSlice вплине на slice2, бо вони ділять базовий масив\n\tsubSlice[0] = 99\n\tfmt.Printf("slice2 після зміни subSlice: %v\\n", slice2)\n\t\n\t// Копіювання зрізів (щоб уникнути спільного базового масиву)\n\tsliceCopy := make([]int, len(slice2))\n\tcopy(sliceCopy, slice2)\n\tsliceCopy[0] = 100\n\tfmt.Printf("Оригінал slice2: %v, Копія: %v\\n", slice2, sliceCopy)\n\t\n\t// 3. МАПИ (MAPS)\n\t// Мапа - це невпорядкована колекція пар ключ-значення\n\t// Ключі мають бути порівнюваними типами\n\tfmt.Println("\\n3. МАПИ:")\n\t\n\t// Створення мап\n\tvar map1 map[string]int             // нульова мапа (nil)\n\tmap2 := make(map[string]int)        // пуста мапа\n\tmap3 := map[string]int{\n\t\t"apple":  5,\n\t\t"banana": 3,\n\t\t"orange": 7,\n\t}\n\t\n\tfmt.Printf("map1: %v (nil? %v)\\n", map1, map1 == nil)\n\tfmt.Printf("map2: %v (пуста? %v)\\n", map2, len(map2) == 0)\n\tfmt.Printf("map3: %v\\n", map3)\n\t\n\t// Операції з мапами\n\tmap3["grape"] = 4                    // додавання\n\tfmt.Printf("map3 після додавання: %v\\n", map3)\n\t\n\tvalue, exists := map3["apple"]       // отримання з перевіркою існування\n\tfmt.Printf("Значення для \'apple\': %d, існує? %v\\n", value, exists)\n\t\n\tdelete(map3, "banana")               // видалення\n\tfmt.Printf("map3 після видалення \'banana\': %v\\n", map3)\n\t\n\t// Ітерація по мапі (порядок не гарантований)\n\tfmt.Print("Ітерація по map3: ")\n\tfor key, val := range map3 {\n\t\tfmt.Printf("%s:%d ", key, val)\n\t}\n\tfmt.Println()\n\t\n\t// 4. КАНАЛИ (CHANNELS)\n\t// Канали - це типізовані конвеєри для спілкування між горутинами\n\t// Дозволяють безпечно передавати дані між паралельними процесами\n\tfmt.Println("\\n4. КАНАЛИ:")\n\t\n\t// Створення каналів\n\tvar ch1 chan int                     // нульовий канал (nil)\n\tch2 := make(chan int)                // небуферизований канал\n\tch3 := make(chan string, 3)          // буферизований канал (ємність 3)\n\t\n\tfmt.Printf("ch1: %v (nil? %v)\\n", ch1, ch1 == nil)\n\tfmt.Printf("ch2: %v (тип: %T)\\n", ch2, ch2)\n\tfmt.Printf("ch3: %v (тип: %T, ємність: %d)\\n", ch3, ch3, cap(ch3))\n\t\n\t// Демонстрація роботи з каналами (спрощена, без горутин)\n\t// У реальних програмах канали використовуються з горутинами\n\tfmt.Println("\\nПримітка: Повноцінна демонстрація каналів вимагає горутин.")\n\tfmt.Println("Ось базові операції:")\n\tfmt.Println("  ch <- data    // відправлення даних у канал")\n\tfmt.Println("  data := <-ch  // отримання даних з каналу")\n\tfmt.Println("  close(ch)     // закриття каналу")\n\t\n\t// 5. ПОРІВНЯННЯ КОЛЕКЦІЙ\n\tfmt.Println("\\n5. ПОРІВНЯННЯ КОЛЕКЦІЙ:")\n\tfmt.Println("  Масиви:")\n\tfmt.Println("    - Фіксований розмір")\n\tfmt.Println("    - Копіювання за значенням (повна копія)")\n\tfmt.Println("    - Ефективні для невеликих фіксованих наборів")\n\t\n\tfmt.Println("  Зрізи:")\n\tfmt.Println("    - Динамічний розмір")\n\tfmt.Println("    - Посилання на базовий масив")\n\tfmt.Println("    - append() може створювати новий базовий масив")\n\t\n\tfmt.Println("  Мапи:")\n\tfmt.Println("    - Ключ-значення")\n\tfmt.Println("    - Швидкий пошук за ключем")\n\tfmt.Println("    - Невпорядковані")\n\t\n\tfmt.Println("  Канали:")\n\tfmt.Println("    - Комунікація між горутинами")\n\tfmt.Println("    - Синхронізація")\n\tfmt.Println("    - Типізовані")\n\t\n\t// 6. ПРАКТИЧНИЙ ПРИКЛАД: ОБРОБКА ДАНИХ\n\tfmt.Println("\\n6. ПРАКТИЧНИЙ ПРИКЛАД: Статистика слів")\n\t\n\ttext := "go мова програмування go мова проста мова потужна"\n\twords := []string{"go", "мова", "програмування", "go", "мова", "проста", "мова", "потужна"}\n\t\n\t// Підрахунок слів за допомогою мапи\n\twordCount := make(map[string]int)\n\tfor _, word := range words {\n\t\twordCount[word]++\n\t}\n\t\n\tfmt.Printf("Текст: %s\\n", text)\n\tfmt.Printf("Статистика слів: %v\\n", wordCount)\n\t\n\t// Знаходження найчастішого слова\n\tmaxWord := ""\n\tmaxCount := 0\n\tfor word, count := range wordCount {\n\t\tif count > maxCount {\n\t\t\tmaxWord = word\n\t\t\tmaxCount = count\n\t\t}\n\t}\n\tfmt.Printf("Найчастіше слово: \'%s\' (%d разів)\\n", maxWord, maxCount)\n\t\n\tfmt.Println("\\n=== ДЕМОНСТРАЦІЯ ЗАВЕРШЕНА ===")\n}\n\n// Додаткові функції для демонстрації\nfunc demonstrateArrays() {\n\t// Масиви передаються за значенням (повна копія)\n\tarr := [3]int{1, 2, 3}\n\tmodifyArray(arr)\n\tfmt.Printf("Після modifyArray: %v (оригінал не змінився)\\n", arr)\n}\n\nfunc modifyArray(a [3]int) {\n\ta[0] = 100\n}\n\nfunc demonstrateSlices() {\n\t// Зрізи передаються за посиланням (на базовий масив)\n\tslice := []int{1, 2, 3}\n\tmodifySlice(slice)\n\tfmt.Printf("Після modifySlice: %v (оригінал змінився)\\n", slice)\n}\n\nfunc modifySlice(s []int) {\n\tif len(s) > 0 {\n\t\ts[0] = 100\n\t}\n}', 'type': 'create_file'}
