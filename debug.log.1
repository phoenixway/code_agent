2026-02-15 15:45:57,446 - debug - DEBUG - Action.start type=create_file command={'before_execution': 'Створюю файл basic_types.go з основами типів та структур в Go', 'during_execution': 'Записую код з детальними коментарами...', 'after_execution': 'Файл basic_types.go створено успішно', 'path': 'golang_examples/basic_types.go', 'content': '// basic_types.go\n// Файл демонструє основні типи даних, структури та інтерфейси в мові Go\n// This file demonstrates basic data types, structures and interfaces in Go\n\npackage main\n\nimport (\n    "fmt"\n)\n\n// ============================================\n// 1. БАЗОВІ ТИПИ (Basic Types)\n// ============================================\n\nfunc demonstrateBasicTypes() {\n    // Цілі числа (Integer types)\n    var age int = 30          // int - платформозалежний цілий тип\n    var height int32 = 180    // int32 - 32-бітне ціле\n    var distance int64 = 1000 // int64 - 64-бітне ціле\n    \n    // Числа з плаваючою точкою (Floating-point types)\n    var weight float32 = 75.5  // float32 - 32-бітне число з плаваючою точкою\n    var pi float64 = 3.14159   // float64 - 64-бітне число з плаваючою точкою (рекомендовано)\n    \n    // Логічний тип (Boolean type)\n    var isReady bool = true\n    var hasError bool = false\n    \n    // Рядки (Strings)\n    var name string = "Іван"\n    var greeting string = "Hello, World!"\n    \n    // Символи (Runes) - представляють Unicode кодпоінт\n    var firstLetter rune = \'A\' // еквівалентно int32\n    var heart rune = \'❤\'\n    \n    fmt.Printf("Вік: %d, Зріст: %d, Відстань: %d\\n", age, height, distance)\n    fmt.Printf("Вага: %.1f, Число Пі: %.5f\\n", weight, pi)\n    fmt.Printf("Готово: %t, Помилка: %t\\n", isReady, hasError)\n    fmt.Printf("Ім\'я: %s, Привітання: %s\\n", name, greeting)\n    fmt.Printf("Перша літера: %c, Серце: %c\\n", firstLetter, heart)\n}\n\n// ============================================\n// 2. СТРУКТУРИ (Structs)\n// ============================================\n\n// Person - структура, що представляє людину\n// Структури в Go - це колекції полів різних типів\n// Вони подібні до класів в інших мовах, але без успадкування\ntype Person struct {\n    FirstName string\n    LastName  string\n    Age       int\n    Email     string\n    IsActive  bool\n}\n\n// Address - структура для адреси\n// Теги struct tags використовуються для рефлексії та серіалізації\ntype Address struct {\n    Street   string `json:"street"`\n    City     string `json:"city"`\n    ZipCode  string `json:"zip_code"`\n    Country  string `json:"country"`\n}\n\nfunc demonstrateStructs() {\n    // Створення екземпляра структури з іменованими полями\n    person1 := Person{\n        FirstName: "Олександр",\n        LastName:  "Петренко",\n        Age:       35,\n        Email:     "olexandr@example.com",\n        IsActive:  true,\n    }\n    \n    // Створення екземпляра без імен полів (порядок має відповідати оголошенню)\n    person2 := Person{"Марія", "Іваненко", 28, "maria@example.com", true}\n    \n    // Створення пустої структури та заповнення полів пізніше\n    var person3 Person\n    person3.FirstName = "Андрій"\n    person3.LastName = "Сидоренко"\n    person3.Age = 42\n    \n    fmt.Printf("Персона 1: %+v\\n", person1)\n    fmt.Printf("Персона 2: %+v\\n", person2)\n    fmt.Printf("Персона 3: %+v\\n", person3)\n    \n    // Доступ до полів структури\n    fmt.Printf("Ім\'я персони 1: %s %s\\n", person1.FirstName, person1.LastName)\n}\n\n// ============================================\n// 3. МАСИВИ ТА СЛАЙСИ (Arrays and Slices)\n// ============================================\n\nfunc demonstrateArraysAndSlices() {\n    // Масив (Array) - фіксованого розміру\n    // Розмір масиву є частиною його типу\n    var numbers [5]int = [5]int{1, 2, 3, 4, 5}\n    var days [7]string = [7]string{\n        "Понеділок", "Вівторок", "Середа",\n        "Четвер", "П\'ятниця", "Субота", "Неділя",\n    }\n    \n    // Слайс (Slice) - динамічний масив\n    // Слайс - це посилання на підмасив\n    var scores []int = []int{85, 90, 78, 92, 88}\n    \n    // Створення слайсу з make\n    prices := make([]float64, 3) // слайс з 3 елементів\n    prices[0] = 19.99\n    prices[1] = 29.99\n    prices[2] = 39.99\n    \n    // Додавання елементів до слайсу\n    scores = append(scores, 95, 87)\n    \n    // Підслайс (slice expression)\n    firstThree := scores[:3]  // перші 3 елементи\n    lastTwo := scores[len(scores)-2:] // останні 2 елементи\n    \n    fmt.Printf("Масив чисел: %v\\n", numbers)\n    fmt.Printf("Дні тижня: %v\\n", days)\n    fmt.Printf("Оцінки: %v\\n", scores)\n    fmt.Printf("Ціни: %v\\n", prices)\n    fmt.Printf("Перші три оцінки: %v\\n", firstThree)\n    fmt.Printf("Останні дві оцінки: %v\\n", lastTwo)\n}\n\n// ============================================\n// 4. МАПИ (Maps)\n// ============================================\n\nfunc demonstrateMaps() {\n    // Мапа (Map) - асоціативний масив, словник\n    // Ключі та значення мають певний тип\n    \n    // Створення мапи з літералу\n    ages := map[string]int{\n        "Олександр": 35,\n        "Марія":     28,\n        "Андрій":    42,\n    }\n    \n    // Створення мапи з make\n    scores := make(map[string]float64)\n    scores["математика"] = 92.5\n    scores["фізика"] = 88.0\n    scores["хімія"] = 95.5\n    \n    // Доступ до елементів мапи\n    ageOfAlex := ages["Олександр"]\n    mathScore, mathExists := scores["математика"] // друга змінна - прапор існування\n    \n    // Видалення елемента\n    delete(scores, "хімія")\n    \n    // Ітерація по мапі\n    fmt.Println("Віки людей:")\n    for name, age := range ages {\n        fmt.Printf("  %s: %d років\\n", name, age)\n    }\n    \n    fmt.Printf("Вік Олександра: %d\\n", ageOfAlex)\n    fmt.Printf("Оцінка з математики: %.1f (існує: %t)\\n", mathScore, mathExists)\n}\n\n// ============================================\n// 5. ІНТЕРФЕЙСИ (Interfaces)\n// ============================================\n\n// Shape - інтерфейс для геометричних фігур\n// Інтерфейс визначає набір методів, які має реалізувати тип\n// Тип автоматично реалізує інтерфейс, якщо має всі його методи\ntype Shape interface {\n    Area() float64\n    Perimeter() float64\n    Name() string\n}\n\n// Circle - структура, що реалізує інтерфейс Shape\ntype Circle struct {\n    Radius float64\n}\n\n// Реалізація методів інтерфейсу Shape для Circle\nfunc (c Circle) Area() float64 {\n    return 3.14159 * c.Radius * c.Radius\n}\n\nfunc (c Circle) Perimeter() float64 {\n    return 2 * 3.14159 * c.Radius\n}\n\nfunc (c Circle) Name() string {\n    return "Коло"\n}\n\n// Rectangle - інша структура, що реалізує Shape\ntype Rectangle struct {\n    Width  float64\n    Height float64\n}\n\nfunc (r Rectangle) Area() float64 {\n    return r.Width * r.Height\n}\n\nfunc (r Rectangle) Perimeter() float64 {\n    return 2 * (r.Width + r.Height)\n}\n\nfunc (r Rectangle) Name() string {\n    return "Прямокутник"\n}\n\nfunc demonstrateInterfaces() {\n    shapes := []Shape{\n        Circle{Radius: 5.0},\n        Rectangle{Width: 4.0, Height: 6.0},\n        Circle{Radius: 2.5},\n    }\n    \n    fmt.Println("Геометричні фігури:")\n    for _, shape := range shapes {\n        fmt.Printf("  %s: площа=%.2f, периметр=%.2f\\n", \n            shape.Name(), shape.Area(), shape.Perimeter())\n    }\n    \n    // Перевірка типу за допомогою type assertion\n    for _, shape := range shapes {\n        if circle, ok := shape.(Circle); ok {\n            fmt.Printf("  Це коло з радіусом: %.2f\\n", circle.Radius)\n        }\n    }\n}\n\n// ============================================\n// ОСНОВНА ФУНКЦІЯ\n// ============================================\n\nfunc main() {\n    fmt.Println("=== ДЕМОНСТРАЦІЯ ОСНОВНИХ ТИПІВ В GO ===")\n    fmt.Println()\n    \n    fmt.Println("1. Базові типи:")\n    demonstrateBasicTypes()\n    fmt.Println()\n    \n    fmt.Println("2. Структури:")\n    demonstrateStructs()\n    fmt.Println()\n    \n    fmt.Println("3. Масиви та слайси:")\n    demonstrateArraysAndSlices()\n    fmt.Println()\n    \n    fmt.Println("4. Мапи:")\n    demonstrateMaps()\n    fmt.Println()\n    \n    fmt.Println("5. Інтерфейси:")\n    demonstrateInterfaces()\n    fmt.Println()\n    \n    fmt.Println("=== ДЕМОНСТРАЦІЯ ЗАВЕРШЕНА ===")\n}\n', 'type': 'create_file'}
