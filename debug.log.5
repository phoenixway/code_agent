  "symbol_kind": "function",
  "include_signature": true,
  "include_body": true,
  "include_line_range": true,
  "before_execution": "Extracting validateKey implementation",
  "during_execution": "Extracting symbol...",
  "after_execution": "Extracted symbol"
}
</action>
```

