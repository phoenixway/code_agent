import unittest

from modules.tui_ui import TuiUI
from modules.agent.technical_interruptions import TechnicalInterruption
from modules.ui_components.technical_interruption_widget import (
    TechnicalInterruptionWidget,
    build_technical_interruption_view_model,
)


class TestTuiUiSanitizer(unittest.TestCase):
    def test_write_file_large_content_is_sanitized_for_display(self):
        command = {
            "type": "write_file",
            "path": "a.txt",
            "content": "x" * 5000,
        }
        safe = TuiUI.sanitize_tool_call_for_display(command, preview_limit=100)

        self.assertEqual(safe["type"], "write_file")
        self.assertEqual(safe["path"], "a.txt")
        self.assertIn("content omitted in UI", safe["content"])
        self.assertEqual(command["content"], "x" * 5000)  # Original is unchanged.

    def test_write_file_small_content_is_not_sanitized(self):
        command = {
            "type": "write_file",
            "path": "a.txt",
            "content": "short",
        }
        safe = TuiUI.sanitize_tool_call_for_display(command, preview_limit=100)
        self.assertEqual(safe["content"], "short")

    def test_assistant_multiline_plain_text_does_not_use_markdown(self):
        text = "Filesystem\n/dev/sda1 90%\n/dev/sdb1 80%"
        self.assertFalse(TuiUI._assistant_text_should_use_markdown(text))

    def test_assistant_markdown_text_still_uses_markdown(self):
        text = "## Summary\n- item one\n- item two"
        self.assertTrue(TuiUI._assistant_text_should_use_markdown(text))

    def test_assistant_prose_plus_star_list_stays_plain_text(self):
        text = "Ось розмір кожної підпапки:\n* 3.6G app\n* 28M core-data-models\n* 20M sync"
        self.assertFalse(TuiUI._assistant_text_should_use_markdown(text))

    def test_technical_interruption_view_model_is_resumable(self):
        interruption = TechnicalInterruption(
            kind="provider_error",
            provider="gemini",
            status_code=503,
            message="Gemini API temporarily unavailable",
            resumable=True,
            resumable_intent_id="intent_123",
        )

        view_model = build_technical_interruption_view_model(interruption)

        self.assertEqual("Відновити роботу", view_model["action_label"])
        self.assertEqual("resume", view_model["action_kind"])
        self.assertTrue(view_model["action_enabled"])

    def test_technical_interruption_widget_uses_retry_for_non_resumable_state(self):
        interruption = TechnicalInterruption(
            kind="provider_error",
            provider="gemini",
            status_code=503,
            message="Gemini API temporarily unavailable",
            resumable=False,
            retryable=True,
        )

        widget = TechnicalInterruptionWidget(interruption)

        self.assertEqual("Retry", widget.view_model["action_label"])
        self.assertEqual("retry", widget.view_model["action_kind"])
        self.assertTrue(widget.view_model["action_enabled"])

    def test_window_title_without_activity_is_base_header(self):
        self.assertEqual(
            "gemini-2.5-pro",
            TuiUI._compose_window_title("gemini-2.5-pro"),
        )

    def test_window_title_with_activity_uses_spinner_and_base_header(self):
        title = TuiUI._compose_window_title(
            "gemini-2.5-pro",
            "thinking",
            spinner_index=2,
        )
        self.assertEqual("gemini-2.5-pro", title)

    def test_activity_label_is_shortened_for_tab_title(self):
        shortened = TuiUI._shorten_title_activity(
            "Reading /very/long/path/to/a/file/that/should/not/take/the/whole/tab/title.py",
            max_chars=24,
        )
        self.assertTrue(shortened.endswith("…"))
        self.assertLessEqual(len(shortened), 24)

    def test_terminal_tab_title_uses_calmer_animation_pattern(self):
        title = TuiUI._compose_terminal_tab_title(
            "gemini-2.5-pro",
            "thinking",
            spinner_index=2,
        )
        self.assertEqual("◝ gemini-2.5-pro", title)


if __name__ == "__main__":
    unittest.main()
