import unittest
from types import SimpleNamespace
from unittest.mock import AsyncMock, MagicMock

from modules.agent.orchestrator import Orchestrator
from modules.agent.planner import TaskBoardPlanner
from modules.agent.state_manager import AgentState
from modules.parser import ResponseParser


class TestOrchestratorPlanner(unittest.IsolatedAsyncioTestCase):
    async def test_injects_plan_board_snapshot_into_next_model_step(self):
        ui = SimpleNamespace(
            print_error=AsyncMock(),
            print_system=AsyncMock(),
            start_thinking=AsyncMock(),
            stop_loading=AsyncMock(),
            confirm_continue=AsyncMock(return_value=False),
            confirm_loop_recovery=AsyncMock(return_value="stop"),
            print_plan=AsyncMock(),
        )
        state = AgentState()
        config = SimpleNamespace(
            MAX_SESSION_SECONDS=120,
            MAX_CONSECUTIVE_CALLS=12,
            MAX_STEP_SECONDS=60,
            LOOP_ERROR_REPEAT_THRESHOLD=2,
            MALFORMED_ACTION_GRACE_STEPS=1,
            RECOVERABLE_ERROR_RETRY_BUDGET=2,
            CRITICAL_ERROR_RETRY_BUDGET=1,
            STATE_CHANGING_OPS={"edit_file", "write_file", "run_shell"},
            IMPLEMENT_STAGNATION_LIMIT=2,
            RESEARCH_STAGNATION_LIMIT=4,
            STAGNATION_MAX_DIAGNOSTICS=1,
            INVARIANT_VIOLATION_LIMIT=1,
            PLANNER_ENABLED=True,
            PLANNER_MODE="auto",
            PLANNER_MAX_STEPS=12,
            PLANNER_MAX_VISIBLE_STEPS=4,
            PLANNER_MAX_GOAL_CHARS=240,
            PLANNER_MAX_STEP_TITLE_CHARS=160,
            PLANNER_MAX_STEP_NOTES_CHARS=240,
            PLANNER_ALWAYS_MISSING_RETRY_LIMIT=2,
        )

        history = SimpleNamespace(
            add_message=MagicMock(),
            check_and_summarize=AsyncMock(),
            current_token_count=0,
            max_tokens=4096,
        )

        async def next_response(*args, **kwargs):
            return "Final answer."

        model_client = SimpleNamespace(get_streaming_response=AsyncMock(side_effect=next_response))
        parser = ResponseParser()

        agent = SimpleNamespace(
            ui=ui,
            state=state,
            history=history,
            model_client=model_client,
            action_dispatcher=SimpleNamespace(dispatch_segments=AsyncMock()),
            parser=parser,
            config=config,
            tool_manager=SimpleNamespace(get_tools_prompt=MagicMock(return_value="")),
            context_manager=SimpleNamespace(get_context_prompt=MagicMock(return_value="")),
            planner=TaskBoardPlanner(config),
            memory_board_store=None,
            memory_board_engine=None,
            log=None,
        )

        orchestrator = Orchestrator(agent)
        state.intent_runtime = SimpleNamespace(active_intent=SimpleNamespace(goal="Fix bug", intent_id="intent_1"))
        agent.planner.apply_update(
            state,
            [
                {"op": "create", "step_id": "sg_1", "status": "in_progress", "title": "Inspect the target file"},
                {"op": "create", "step_id": "sg_2", "status": "todo", "title": "Edit the implementation"},
            ],
        )
        ctx = SimpleNamespace(
            current_query="fix this issue",
            malformed_action_retries=0,
            audit_marker_retries=0,
            consecutive_calls=0,
            active_loop=True,
            tools_prompt="",
            ctx_prompt="",
        )

        await orchestrator.pipeline._run_model_step(ctx)

        calls = model_client.get_streaming_response.await_args_list
        self.assertEqual(len(calls), 1)
        injected_messages = calls[0].kwargs.get("injected_messages") or ()
        injected_text = "\n".join(str(msg.get("content", "")) for msg in injected_messages if isinstance(msg, dict))
        self.assertIn("CURRENT PLAN BOARD", injected_text)
        self.assertIn("sg_1 [in_progress]", injected_text)

    async def test_injects_recovery_instruction_overlay_into_next_model_step(self):
        ui = SimpleNamespace(
            print_error=AsyncMock(),
            print_system=AsyncMock(),
            start_thinking=AsyncMock(),
            stop_loading=AsyncMock(),
            confirm_continue=AsyncMock(return_value=False),
            confirm_loop_recovery=AsyncMock(return_value="stop"),
            print_plan=AsyncMock(),
        )
        state = AgentState()
        config = SimpleNamespace(
            MAX_SESSION_SECONDS=120,
            MAX_CONSECUTIVE_CALLS=12,
            MAX_STEP_SECONDS=60,
            LOOP_ERROR_REPEAT_THRESHOLD=2,
            MALFORMED_ACTION_GRACE_STEPS=1,
            RECOVERABLE_ERROR_RETRY_BUDGET=2,
            CRITICAL_ERROR_RETRY_BUDGET=1,
            STATE_CHANGING_OPS={"edit_file", "write_file", "run_shell"},
            IMPLEMENT_STAGNATION_LIMIT=2,
            RESEARCH_STAGNATION_LIMIT=4,
            STAGNATION_MAX_DIAGNOSTICS=1,
            INVARIANT_VIOLATION_LIMIT=1,
            PLANNER_ENABLED=True,
            PLANNER_MODE="auto",
            PLANNER_MAX_STEPS=12,
            PLANNER_MAX_VISIBLE_STEPS=4,
            PLANNER_MAX_GOAL_CHARS=240,
            PLANNER_MAX_STEP_TITLE_CHARS=160,
            PLANNER_MAX_STEP_NOTES_CHARS=240,
            PLANNER_ALWAYS_MISSING_RETRY_LIMIT=2,
        )

        recovery_overlay = [
            {
                "role": "system",
                "content": "## CURRENT RECOVERY INSTRUCTIONS\nRetry search_content with literal=true.",
            }
        ]
        history = SimpleNamespace(
            add_message=MagicMock(),
            check_and_summarize=AsyncMock(),
            current_token_count=0,
            max_tokens=4096,
            build_recovery_instruction_injected_messages=MagicMock(return_value=recovery_overlay),
        )

        async def next_response(*args, **kwargs):
            return "Final answer."

        model_client = SimpleNamespace(get_streaming_response=AsyncMock(side_effect=next_response))
        parser = ResponseParser()

        agent = SimpleNamespace(
            ui=ui,
            state=state,
            history=history,
            model_client=model_client,
            action_dispatcher=SimpleNamespace(dispatch_segments=AsyncMock()),
            parser=parser,
            config=config,
            tool_manager=SimpleNamespace(get_tools_prompt=MagicMock(return_value="")),
            context_manager=SimpleNamespace(get_context_prompt=MagicMock(return_value="")),
            planner=TaskBoardPlanner(config),
            memory_board_store=None,
            memory_board_engine=None,
            log=None,
        )

        orchestrator = Orchestrator(agent)
        ctx = SimpleNamespace(
            current_query="fix this issue",
            malformed_action_retries=0,
            audit_marker_retries=0,
            consecutive_calls=0,
            active_loop=True,
            tools_prompt="",
            ctx_prompt="",
        )

        await orchestrator.pipeline._run_model_step(ctx)

        history.build_recovery_instruction_injected_messages.assert_called_once_with(state=state)
        calls = model_client.get_streaming_response.await_args_list
        self.assertEqual(len(calls), 1)
        injected_messages = calls[0].kwargs.get("injected_messages") or ()
        injected_text = "\n".join(str(msg.get("content", "")) for msg in injected_messages if isinstance(msg, dict))
        self.assertIn("CURRENT RECOVERY INSTRUCTIONS", injected_text)
        self.assertIn("Retry search_content with literal=true.", injected_text)

    async def test_plan_only_checkpoint_prompts_for_substantive_continuation(self):
        ui = SimpleNamespace(
            print_error=AsyncMock(),
            print_system=AsyncMock(),
            start_thinking=AsyncMock(),
            stop_loading=AsyncMock(),
            confirm_continue=AsyncMock(return_value=False),
            confirm_loop_recovery=AsyncMock(return_value="stop"),
            print_plan=AsyncMock(),
        )
        state = AgentState()
        config = SimpleNamespace(
            MAX_SESSION_SECONDS=120,
            MAX_CONSECUTIVE_CALLS=12,
            MAX_STEP_SECONDS=60,
            LOOP_ERROR_REPEAT_THRESHOLD=2,
            MALFORMED_ACTION_GRACE_STEPS=1,
            RECOVERABLE_ERROR_RETRY_BUDGET=2,
            CRITICAL_ERROR_RETRY_BUDGET=1,
            STATE_CHANGING_OPS={"edit_file", "write_file", "run_shell"},
            IMPLEMENT_STAGNATION_LIMIT=2,
            RESEARCH_STAGNATION_LIMIT=4,
            STAGNATION_MAX_DIAGNOSTICS=1,
            INVARIANT_VIOLATION_LIMIT=1,
            PLANNER_ENABLED=True,
            PLANNER_MODE="always",
            PLANNER_MAX_STEPS=12,
            PLANNER_MAX_VISIBLE_STEPS=4,
            PLANNER_MAX_GOAL_CHARS=240,
            PLANNER_MAX_STEP_TITLE_CHARS=160,
            PLANNER_MAX_STEP_NOTES_CHARS=240,
            PLANNER_ALWAYS_MISSING_RETRY_LIMIT=2,
        )

        history = SimpleNamespace(
            add_message=MagicMock(),
            check_and_summarize=AsyncMock(),
            current_token_count=0,
            max_tokens=4096,
        )

        model_client = SimpleNamespace(get_streaming_response=AsyncMock(return_value="Final answer."))
        parser = ResponseParser()

        agent = SimpleNamespace(
            ui=ui,
            state=state,
            history=history,
            model_client=model_client,
            action_dispatcher=SimpleNamespace(dispatch_segments=AsyncMock()),
            parser=parser,
            config=config,
            tool_manager=SimpleNamespace(get_tools_prompt=MagicMock(return_value="")),
            context_manager=SimpleNamespace(get_context_prompt=MagicMock(return_value="")),
            planner=TaskBoardPlanner(config),
            memory_board_store=None,
            memory_board_engine=None,
            log=None,
        )

        orchestrator = Orchestrator(agent)
        ctx = SimpleNamespace(
            state_machine=None,
            malformed_action_retries=0,
            audit_marker_retries=0,
            user_input="fix this issue",
        )
        step = SimpleNamespace(
            response='<subgoal action="create" id="sg_1" status="in_progress">Inspect the target file</subgoal>',
            intent_payload=None,
            intent_error=None,
        )

        outcome = await orchestrator.response_pipeline.run_step(ctx, step)

        self.assertTrue(outcome.continue_loop)
        self.assertIn("Plan updates were recorded", outcome.next_query)
        ui.print_plan.assert_awaited()

    async def test_intent_activation_and_nested_tool_action_continue_within_same_process(self):
        ui = SimpleNamespace(
            print_error=AsyncMock(),
            print_system=AsyncMock(),
            start_thinking=AsyncMock(),
            stop_loading=AsyncMock(),
            confirm_continue=AsyncMock(return_value=False),
            confirm_loop_recovery=AsyncMock(return_value="stop"),
            print_plan=AsyncMock(),
        )
        config = SimpleNamespace(
            MAX_SESSION_SECONDS=120,
            MAX_CONSECUTIVE_CALLS=12,
            MAX_STEP_SECONDS=60,
            LOOP_ERROR_REPEAT_THRESHOLD=2,
            MALFORMED_ACTION_GRACE_STEPS=1,
            RECOVERABLE_ERROR_RETRY_BUDGET=2,
            CRITICAL_ERROR_RETRY_BUDGET=1,
            STATE_CHANGING_OPS={"edit_file", "write_file", "run_shell"},
            IMPLEMENT_STAGNATION_LIMIT=2,
            RESEARCH_STAGNATION_LIMIT=4,
            STAGNATION_MAX_DIAGNOSTICS=1,
            INVARIANT_VIOLATION_LIMIT=1,
            PLANNER_ENABLED=True,
            PLANNER_MODE="auto",
            PLANNER_MAX_STEPS=12,
            PLANNER_MAX_VISIBLE_STEPS=4,
            PLANNER_MAX_GOAL_CHARS=240,
            PLANNER_MAX_STEP_TITLE_CHARS=160,
            PLANNER_MAX_STEP_NOTES_CHARS=240,
            PLANNER_ALWAYS_MISSING_RETRY_LIMIT=2,
            INTENT_RELABEL_SUSPICION_ENABLED=False,
        )
        state = AgentState(config)
        state.state_machine = SimpleNamespace(
            start_turn=MagicMock(),
            decide=MagicMock(return_value=SimpleNamespace(decision=SimpleNamespace(name="CONTINUE"))),
            intent_runtime=None,
        )

        history = SimpleNamespace(
            add_message=MagicMock(),
            check_and_summarize=AsyncMock(),
            current_token_count=0,
            max_tokens=4096,
            start_turn=MagicMock(),
        )

        responses = [
            (
                '<intent mode="activate">{'
                '"intent_id":"activity_tracker_edit",'
                '"intent_type":"INVESTIGATE",'
                '"goal":"Understand current implementation of activity tracker sorting and edit dialog to plan changes for editable startTime and sorting by startTime",'
                '"allowed_actions":["run_shell","read_chunk","search_content"],'
                '"safe_steps_limit":4,'
                '"retry_limit":2,'
                '"mode":"activate"'
                "}</intent>"
            ),
            (
                "<action>\n"
                "<run_shell>{\"command\":\"echo ok\"}</run_shell>\n"
                "</action>"
            ),
        ]
        model_client = SimpleNamespace(get_streaming_response=AsyncMock(side_effect=responses))
        parser = ResponseParser()
        dispatched_commands = []

        async def dispatch_segments(segments, _state):
            action_segments = [seg for seg in segments if seg.type == "action"]
            dispatched_commands.extend(seg.content for seg in action_segments)
            return segments, ["SYSTEM RESULT for `run_shell`: ok"], True

        agent = SimpleNamespace(
            ui=ui,
            state=state,
            history=history,
            model_client=model_client,
            action_dispatcher=SimpleNamespace(dispatch_segments=dispatch_segments),
            parser=parser,
            config=config,
            tool_manager=SimpleNamespace(get_tools_prompt=MagicMock(return_value="")),
            context_manager=SimpleNamespace(get_context_prompt=MagicMock(return_value="")),
            planner=TaskBoardPlanner(config),
            memory_board_store=None,
            memory_board_engine=None,
            log=None,
        )

        orchestrator = Orchestrator(agent)
        await orchestrator.process("inspect the activity tracker flow")

        queries = [call.args[0] for call in model_client.get_streaming_response.await_args_list]
        self.assertEqual(len(queries), 2)
        self.assertIn("inspect the activity tracker flow", queries[0])
        self.assertIn("Intent accepted. The current contract is now active", queries[1])
        self.assertIn(
            "Current contract goal remains the same: Understand current implementation of activity tracker sorting and edit dialog to plan changes for editable startTime and sorting by startTime.",
            queries[1],
        )

        self.assertEqual(len(dispatched_commands), 1)
        self.assertEqual(dispatched_commands[0]["type"], "run_shell")
        self.assertEqual(dispatched_commands[0]["command"], "echo ok")
        self.assertIsNotNone(state.active_intent)
        self.assertEqual(state.active_intent.intent_id, "activity_tracker_edit")
        self.assertEqual(state.active_intent.mode, "activate")


if __name__ == "__main__":
    unittest.main()
