import unittest

from modules.agent.policy_engine import LoopPolicyInput, PolicyEngine, PreActionPolicyInput


class TestPolicyEngine(unittest.TestCase):
    def setUp(self):
        self.engine = PolicyEngine()

    def test_pre_action_denies_recover_repeated_fingerprint(self):
        decision = self.engine.evaluate_pre_action(
            PreActionPolicyInput(
                cmd_type="read_file",
                path="a.txt",
                fingerprint="fp-1",
                target_file="a.txt",
                forbidden_recover_fingerprint="fp-1",
                has_cross_target_reason=False,
            )
        )
        self.assertTrue(decision.allow)

    def test_pre_action_allows_cross_target_without_reason_while_guard_is_disabled(self):
        decision = self.engine.evaluate_pre_action(
            PreActionPolicyInput(
                cmd_type="read_file",
                path="b.txt",
                fingerprint="fp-2",
                target_file="a.txt",
                forbidden_recover_fingerprint=None,
                has_cross_target_reason=False,
            )
        )
        self.assertTrue(decision.allow)

    def test_loop_returns_diagnostic_on_stagnation(self):
        decision = self.engine.evaluate_loop(
            LoopPolicyInput(
                stagnation_count=3,
                read_only_limit=3,
                diagnostic_attempts=0,
                max_diagnostics=1,
                diagnostic_prompt="diag",
                required_next_action_types=["search_content"],
            )
        )
        self.assertEqual(decision.decision, "MODEL_DIAGNOSTIC")
        self.assertEqual(decision.prompt, "diag")

    def test_pre_action_allows_cross_target_with_explicit_reason(self):
        decision = self.engine.evaluate_pre_action(
            PreActionPolicyInput(
                cmd_type="read_file",
                path="b.txt",
                fingerprint="fp-3",
                target_file="a.txt",
                forbidden_recover_fingerprint=None,
                has_cross_target_reason=True,
            )
        )
        self.assertTrue(decision.allow)

    def test_loop_returns_handoff_after_diagnostics_exhausted(self):
        decision = self.engine.evaluate_loop(
            LoopPolicyInput(
                stagnation_count=3,
                read_only_limit=3,
                diagnostic_attempts=1,
                max_diagnostics=1,
                diagnostic_prompt="diag",
                required_next_action_types=["search_content"],
            )
        )
        self.assertEqual(decision.decision, "USER_HANDOFF")

    def test_pre_action_denies_reread_after_summary(self):
        decision = self.engine.evaluate_pre_action(
            PreActionPolicyInput(
                cmd_type="read_file",
                path="a.txt",
                fingerprint="fp-4",
                target_file=None,
                forbidden_recover_fingerprint=None,
                has_cross_target_reason=False,
                already_read_current_version=True,
                reread_reason_ok=False,
                reread_after_summary=True,
            )
        )
        self.assertFalse(decision.allow)
        self.assertEqual(decision.stop_reason, "reread_after_summary")

    def test_pre_action_allows_reread_with_reason(self):
        decision = self.engine.evaluate_pre_action(
            PreActionPolicyInput(
                cmd_type="read_file",
                path="fresh.txt",
                fingerprint="fp-5",
                target_file=None,
                forbidden_recover_fingerprint=None,
                has_cross_target_reason=False,
                already_read_current_version=True,
                reread_reason_ok=True,
                reread_after_summary=True,
            )
        )
        self.assertTrue(decision.allow)


if __name__ == "__main__":
    unittest.main()
