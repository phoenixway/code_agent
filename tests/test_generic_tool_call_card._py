import unittest

from modules.ui_components.generic_tool_call_card import (
    build_generic_tool_call_presentation,
    has_specialized_tool_call_renderer,
)


class TestGenericToolCallPresentation(unittest.TestCase):
    def test_specialized_router_keeps_special_tools_out_of_generic_fallback(self):
        self.assertTrue(has_specialized_tool_call_renderer({"type": "read_file"}))
        self.assertTrue(has_specialized_tool_call_renderer({"type": "run_shell"}))
        self.assertFalse(has_specialized_tool_call_renderer({"type": "read_chunk"}))
        self.assertFalse(has_specialized_tool_call_renderer({"type": "search_content"}))

    def test_search_content_builds_human_summary_and_hits_chip(self):
        presentation = build_generic_tool_call_presentation(
            {
                "type": "search_content",
                "pattern": "ActivityRecord",
                "path": "app/src/main",
                "recursive": True,
                "code_only": True,
                "limit": 1,
            },
            {
                "status": "success",
                "result_count": 2,
                "output": "app/src/main/feature/ActivityTrackerScreen.kt:168: private enum class ActivityRecordType",
            },
        )

        self.assertEqual(presentation.summary, "Find ActivityRecord")
        self.assertEqual(presentation.status_text, "2 hits")
        self.assertIn("ActivityTrackerScreen.kt:168", presentation.primary_result)
        self.assertTrue(presentation.is_expandable)

    def test_long_paths_keep_filename_visible(self):
        presentation = build_generic_tool_call_presentation(
            {
                "type": "create_file",
                "path": "/very/long/root/path/with/many/segments/and/a/deeply/nested/feature/final_file_name.py",
            }
        )

        self.assertIn("final_file_name.py", presentation.primary_result)

    def test_running_status_is_compact(self):
        presentation = build_generic_tool_call_presentation(
            {"type": "search_files", "query": "history"}
        )
        self.assertEqual(presentation.status_text, "…")

    def test_failed_status_is_compact(self):
        presentation = build_generic_tool_call_presentation(
            {"type": "search_files", "query": "history"},
            {"status": "error", "output": "ripgrep failed"},
        )
        self.assertEqual(presentation.status_text, "×")

    def test_no_results_status_is_compact(self):
        presentation = build_generic_tool_call_presentation(
            {"type": "search_content", "pattern": "MissingThing"},
            {"status": "success", "result_count": 0, "output": "0 matches found"},
        )
        self.assertEqual(presentation.status_text, "0")


if __name__ == "__main__":
    unittest.main()
