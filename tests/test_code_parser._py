import unittest
from unittest.mock import patch

from modules.code_parser import CodeParser


class TestCodeParserLibPath(unittest.TestCase):
    def test_get_lib_path_falls_back_to_android_folder(self):
        parser = CodeParser()

        with patch("modules.code_parser.platform.machine", return_value="aarch64"), patch.dict(
            "modules.code_parser.os.environ", {}, clear=False
        ), patch(
            "modules.code_parser.os.path.exists",
            side_effect=lambda p: p.endswith("libs/android_aarch64/kotlin.so"),
        ):
            path = parser._get_lib_path("kotlin.so")

        self.assertTrue(path.endswith("libs/android_aarch64/kotlin.so"))

    def test_get_lib_path_prefers_detected_system_folder(self):
        parser = CodeParser()

        with patch("modules.code_parser.platform.machine", return_value="x86_64"), patch.dict(
            "modules.code_parser.os.environ", {"PREFIX": "/data/data/com.termux/files/usr"},
            clear=False
        ), patch(
            "modules.code_parser.os.path.exists",
            side_effect=lambda p: p.endswith("libs/linux_x86_64/python.so"),
        ):
            path = parser._get_lib_path("python.so")

        self.assertTrue(path.endswith("libs/linux_x86_64/python.so"))


class TestCodeParserSkeletonRanges(unittest.TestCase):
    def test_unsupported_file_type_falls_back_without_ranges(self):
        parser = CodeParser()

        out = parser.get_skeleton("notes.txt", "hello\nworld")

        self.assertIn("skeleton not supported for this file type", out)


if __name__ == "__main__":
    unittest.main()
